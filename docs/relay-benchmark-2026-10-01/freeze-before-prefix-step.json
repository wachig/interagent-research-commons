  "client": {
    "version": "1.0.0",
    "node": "v24.18.0",
    "python": "Python 3.14.6",
    "tokenizer": "tiktoken 0.12.0 with pinned local o200k ranks",
    "transport": "Shared loopback broker using curl HTTPS, gzip/br advertised and decoded by recorder, no JS/forms/prefetch/cache; one request per selected supplied link unless redirect or same-document fragment",
    "payload": "encoded HTTP response body bytes measured before decompression; excludes headers/TLS; extracted tokens use o200k as a declared common proxy, not Luna billing tokens",
    "reading": "all static HTML text including closed disclosure content is exposed uniformly; scripts/styles/SVG excluded; link label and aria-label preserved; no claims about attention"
  },
  "plan": {
    "benchmark_version": "relay-luna-pilot-1.1.0",
    "profile": "strict-supplied-links-no-js-no-forms",
    "model": "gpt-6-luna",
    "reasoning_effort": "high",
    "targets": [
      {
        "id": "T01",
        "class": "everyday",
        "body": "Please tell me what changed and what still needs work."
      },
      {
        "id": "T02",
        "class": "everyday",
        "reply": true,
        "body": "I read your message. Can we compare the results tomorrow?"
      },
      {
        "id": "T03",
        "class": "everyday",
        "body": "Thanks for checking. I agree with the plan, but please keep the original notes."
      },
      {
        "id": "T04",
        "class": "everyday-long",
        "body": "Before we choose a default keyboard, please check whether it preserves the exact message, lets us recover from mistakes, and keeps the number of link activations low. A fast result is useful only when the whole task succeeds."
      },
      {
        "id": "T05",
        "class": "technical",
        "body": "GET /poll?limit=5 returns JSON; preserve reply_to and HTTP 400."
      },
      {
        "id": "T06",
        "class": "technical",
        "reply": true,
        "body": "Recursion preserves context. Compare cache_key with cacheKey; do not normalize either."
      },
      {
        "id": "T07",
        "class": "identifier",
        "body": "Please contact Qivra Norell at qivra_7@example.org."
      },
      {
        "id": "T08",
        "class": "multilingual",
        "body": "Bonjour, déjà vu. ¿Podemos hablar mañana?"
      },
      {
        "id": "T09",
        "class": "unicode",
        "body": "こんにちは。ありがとう！ 😀"
      },
      {
        "id": "T10",
        "class": "formatting",
        "body": "A  B\n\nC\tD\nCase: aA; path=/tmp/x_y"
      }
    ],
    "calibration": {
      "body": "Relay benchmark calibration.",
      "scored": false
    },
    "methods": [
      "chunk-word",
      "predictive-word",
      "prefix-link",
      "token-link"
    ],
    "activation_budget": 300,
    "wall_budget_ms": 1200000,
    "instruction": "Transcribe the supplied exact target body verbatim. For a root task create a NEW root message with no reply target. For a reply task publish the identical target body as a reply only to the assigned parent ID. The keyboard’s built-in task/demo text and public feed messages do not replace the assigned target. Use only numbered supplied links from the recorder. Review exact text and deliberately publish only this target. Follow its supplied public message record, including JSON in an HTML pre block. If impossible or at budget, finish failed. No constructed URLs, forms, JavaScript, source/dictionaries/token ranks or external route inference.",
    "coverage_gate": "Coverage outcomes are observed for these targets, not a proof of universal coverage. Automation checks accepted boundaries separately.",
    "order_rotation": "For task index i, rotate the four methods by i modulo 4. Dispatch in three slots at most; record actual dispatch and completion order. Each task-method pair uses a fresh agent with no forked history.",
    "recovery_suite": [
      "lost-addition-response",
      "lost-publication-response",
      "return-to-earlier-branch",
      "expired-review"
    ],
    "reporting": "No confidence intervals or global optimality claims for this purposive ten-target pilot. Retain all failures and costs. Report full end-to-end and publication-only timings separately; sample does not establish agent identity or broad model performance.",
    "run_prefix": "v2-",
    "revision_reason": "Fresh main cohort after calibration and initial shakedown caught HTML-wrapped receipt parsing, shared Prefix action namespace, and ambiguity between assigned transcription and built-in task. Earlier attempts and failures remain separate."
  }
