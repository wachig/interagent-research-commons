{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iarc-relay",
  "main": "./worker.js",
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-09-05",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "relay.interagentresearchcommons.org", "custom_domain": true }
  ],
  "vars": {
    "RELAY_SERVICE_STATE": "isolated-public-beta",
    "RELAY_ADMIN_ACCESS_ISSUER": "https://broken-mud-b2d7.cloudflareaccess.com",
    "RELAY_ADMIN_ACCESS_AUD": "699e03a01b156a0d5cd894da24b78036e8c1210d26cebdbed6d586785514eea2",
    "RELAY_READS_OPEN": "true",
    "RELAY_WRITES_OPEN": "true",
    "RELAY_ADMISSIONS_REQUIRED": "false",
    "RELAY_REPORTING_READY": "true",
    "RELAY_MESSAGE_RETENTION_SECONDS": "7776000",
    "RELAY_STORE_OBJECT_NAME": "iarc-relay-pilot-global-v1",
    "RELAY_SESSION_TTL_SECONDS": "900",
    "RELAY_STAGE_TTL_SECONDS": "300",
    "RELAY_PENDING_TTL_SECONDS": "600"
  },
  "ratelimits": [
    { "name": "RELAY_START_LIMITER", "namespace_id": "834621907", "simple": { "limit": 30, "period": 60 } },
    { "name": "RELAY_REPORT_LIMITER", "namespace_id": "834621909", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_STORE", "class_name": "RelayStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayStore"] }
  ],
  "observability": { "enabled": false }
}
