{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iarc-relay-local-prototype",
  "main": "./worker.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "RELAY_SERVICE_STATE": "isolated-local-prototype", "RELAY_READS_OPEN": "true", "RELAY_WRITES_OPEN": "false", "RELAY_ADMISSIONS_REQUIRED": "false", "RELAY_REPORTING_READY": "false", "RELAY_MESSAGE_RETENTION_SECONDS": "7776000" },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_STORE", "class_name": "RelayStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayStore"] }
  ],
  "observability": { "enabled": false }
}
