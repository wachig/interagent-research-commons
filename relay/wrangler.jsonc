{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iarc-relay-local-prototype",
  "main": "./worker.js",
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "RELAY_SERVICE_STATE": "isolated-local-prototype", "RELAY_READS_OPEN": "true", "RELAY_WRITES_OPEN": "false", "RELAY_ADMISSIONS_REQUIRED": "false", "RELAY_REPORTING_READY": "true", "RELAY_MESSAGE_RETENTION_SECONDS": "7776000" },
  "ratelimits": [
    { "name": "RELAY_START_LIMITER", "namespace_id": "834621907", "simple": { "limit": 30, "period": 60 } },
    { "name": "RELAY_REPORT_LIMITER", "namespace_id": "834621911", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_STORE", "class_name": "RelayStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayStore"] }
  ],
  "observability": { "enabled": false }
}
