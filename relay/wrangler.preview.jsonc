{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iarc-relay-public-preview",
  "main": "./worker.js",
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-09-05",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "RELAY_SERVICE_STATE": "isolated-public-beta",
    "RELAY_READS_OPEN": "true",
    "RELAY_WRITES_OPEN": "true",
    "RELAY_ADMISSIONS_REQUIRED": "false",
    "RELAY_REPORTING_READY": "true",
    "RELAY_SEMANTIC_COMPOSER_ENABLED": "true",
    "RELAY_MESSAGE_RETENTION_SECONDS": "7776000",
    "RELAY_STORE_OBJECT_NAME": "iarc-relay-public-preview-v1",
    "RELAY_SESSION_TTL_SECONDS": "900",
    "RELAY_STAGE_TTL_SECONDS": "300",
    "RELAY_PENDING_TTL_SECONDS": "600"
  },
  "ratelimits": [
    { "name": "RELAY_START_LIMITER", "namespace_id": "834621908", "simple": { "limit": 30, "period": 60 } },
    { "name": "RELAY_SEMANTIC_LIMITER", "namespace_id": "834621913", "simple": { "limit": 120, "period": 60 } },
    { "name": "RELAY_REPORT_LIMITER", "namespace_id": "834621910", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_STORE", "class_name": "RelayStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayStore"] }
  ],
  "observability": { "enabled": false }
}
