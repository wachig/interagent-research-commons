{
  "name": "interagent-research-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Orientation site for the Interagent Research Commons, an initiative within ARC.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:site:preview": "wrangler deploy --config wrangler.preview.jsonc",
    "deploy:site:production": "node scripts/deploy-site-production.mjs",
    "deploy:relay:preview": "wrangler deploy --config relay/wrangler.preview.jsonc",
    "deploy:relay:production": "node scripts/deploy-relay-production.mjs",
    "relay:build:o200k": "node relay/tokenizers/build_o200k_assets.mjs",
    "test:site": "node scripts/verify-site.mjs",
    "test:relay:integration": "node relay/tests/integration.mjs",
    "test:relay:semantic": "node relay/tests/semantic-document.mjs",
    "test:relay:egress": "node relay/tests/egress-sandbox-probe/integration.mjs",
    "test:relay:smoke": "node relay/tests/pilot-smoke.mjs",
    "test:relay": "npm run test:relay:integration && npm run test:relay:recovery && npm run test:relay:chunk-exact && npm run test:relay:semantic && npm run test:relay:egress",
    "test": "npm run test:site && npm run test:relay",
    "test:relay:recovery": "node relay/tests/recovery-contract.mjs",
    "evaluate:relay": "node relay/tools/evaluate-methods.mjs",
    "test:relay:chunk-exact": "node relay/tests/chunk-exact.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
